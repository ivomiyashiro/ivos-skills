import { describe, expect, test } from 'bun:test';
import pino from 'pino';
import { Hono } from 'hono';
import type { Db } from '@shared/db/client';
import { createEventBus } from '@shared/events/event-bus';
import type { AppEnv } from '@shared/hono/types';
import { build__Features__Routes } from './__features__.routes';
import type { __Feature__UseCasesDeps } from '../use-cases/__features__.use-cases';

const createInMemoryDeps = (): __Feature__UseCasesDeps => {
  const db = {} as Db;

  return {
    createRepo: () => ({
      findById: async () => null,
      save: async () => undefined,
      delete: async () => undefined,
    }),
    readModel: {
      getById: async () => null,
      list: async () => ({ items: [], nextCursor: null }),
    },
    tx: {
      run: async <T>(operation: (tx: Db) => Promise<T>) => operation(db),
    },
    eventBus: createEventBus(),
    logger: pino({ enabled: false }),
    clock: { now: () => new Date('2026-01-01T00:00:00.000Z') },
  };
};

describe('__features__ routes', () => {
  test('GET /__features__ rejects anonymous requests and lists for authenticated users', async () => {
    const deps = createInMemoryDeps();
    const anonymousApp = new Hono<AppEnv>();
    anonymousApp.route('/__features__', build__Features__Routes(deps));

    const anonymous = await anonymousApp.request('/__features__');
    expect(anonymous.status).toBe(401);

    const authenticatedApp = new Hono<AppEnv>();
    authenticatedApp.use('*', async (c, next) => {
      c.set('auth', { userId: '00000000-0000-4000-8000-000000000001', roles: [] });
      await next();
    });
    authenticatedApp.route('/__features__', build__Features__Routes(deps));

    const authenticated = await authenticatedApp.request('/__features__');

    expect(authenticated.status).toBe(200);
    expect(await authenticated.json()).toEqual({ items: [], nextCursor: null });
  });
});
