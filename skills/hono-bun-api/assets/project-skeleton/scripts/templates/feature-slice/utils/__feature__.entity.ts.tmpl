import type { __Feature__Status } from '../__features__.schemas';
import type { __Feature__Event } from './__feature__.events';

export type __Feature__Props = {
  id: string;
  name: string;
  status: __Feature__Status;
  createdAt: Date;
  updatedAt: Date;
};

export class __Feature__ {
  private readonly events: __Feature__Event[] = [];

  private constructor(private props: __Feature__Props) {}

  static create(input: { name: string; now: Date }): __Feature__ {
    const entity = new __Feature__({
      id: crypto.randomUUID(),
      name: input.name,
      status: 'draft',
      createdAt: input.now,
      updatedAt: input.now,
    });

    entity.events.push({
      type: '__Feature__Created',
      payload: { id: entity.id, name: entity.name },
      occurredAt: input.now,
    });

    return entity;
  }

  static rehydrate(props: __Feature__Props): __Feature__ {
    return new __Feature__(props);
  }

  get id() {
    return this.props.id;
  }

  get name() {
    return this.props.name;
  }

  get status() {
    return this.props.status;
  }

  get createdAt() {
    return this.props.createdAt;
  }

  get updatedAt() {
    return this.props.updatedAt;
  }

  update(input: { name?: string; status?: __Feature__Status; now: Date }) {
    this.props = {
      ...this.props,
      ...('name' in input && input.name !== undefined ? { name: input.name } : {}),
      ...('status' in input && input.status !== undefined ? { status: input.status } : {}),
      updatedAt: input.now,
    };

    this.events.push({
      type: '__Feature__Updated',
      payload: { id: this.id },
      occurredAt: input.now,
    });
  }

  pullEvents(): __Feature__Event[] {
    const events = [...this.events];
    this.events.length = 0;
    return events;
  }
}
