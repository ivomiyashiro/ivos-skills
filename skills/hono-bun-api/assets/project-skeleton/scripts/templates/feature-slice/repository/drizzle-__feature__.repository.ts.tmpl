import { eq } from 'drizzle-orm';
import type { Db } from '@shared/db/client';
import { __features__ } from '@shared/db/schema';
import type { __Feature__Repository } from './__feature__.repository';
import type { __Feature__ } from '../utils/__feature__.entity';
import { __Feature__Mapper } from './__feature__.mapper';

export class Drizzle__Feature__Repository implements __Feature__Repository {
  constructor(private readonly db: Db) {}

  async findById(id: string): Promise<__Feature__ | null> {
    const rows = await this.db.select().from(__features__).where(eq(__features__.id, id)).limit(1);
    return rows[0] ? __Feature__Mapper.toDomain(rows[0]) : null;
  }

  async save(entity: __Feature__): Promise<void> {
    const row = __Feature__Mapper.toPersistence(entity);

    await this.db
      .insert(__features__)
      .values(row)
      .onConflictDoUpdate({
        target: __features__.id,
        set: {
          name: row.name,
          status: row.status,
          updatedAt: row.updatedAt,
        },
      });
  }

  async delete(id: string): Promise<void> {
    await this.db.delete(__features__).where(eq(__features__.id, id));
  }
}
