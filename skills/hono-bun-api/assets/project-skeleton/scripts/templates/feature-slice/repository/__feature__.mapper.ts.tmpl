import type { __Feature__Insert, __Feature__Row } from '@shared/db/schema';
import { __Feature__ } from '../utils/__feature__.entity';

export const __Feature__Mapper = {
  toDomain(row: __Feature__Row): __Feature__ {
    return __Feature__.rehydrate({
      id: row.id,
      name: row.name,
      status: row.status,
      createdAt: row.createdAt,
      updatedAt: row.updatedAt,
    });
  },

  toPersistence(entity: __Feature__): __Feature__Insert {
    return {
      id: entity.id,
      name: entity.name,
      status: entity.status,
      createdAt: entity.createdAt,
      updatedAt: entity.updatedAt,
    };
  },
};
