import { __Feature__ } from '../utils/__feature__.entity';

export type __Feature__Persistence = {
  id: string;
  name: string;
  status: __Feature__['status'];
  createdAt: Date;
  updatedAt: Date;
};

export const __Feature__Mapper = {
  toDomain(row: __Feature__Persistence): __Feature__ {
    return __Feature__.rehydrate({
      id: row.id,
      name: row.name,
      status: row.status,
      createdAt: row.createdAt,
      updatedAt: row.updatedAt,
    });
  },

  toPersistence(entity: __Feature__): __Feature__Persistence {
    return {
      id: entity.id,
      name: entity.name,
      status: entity.status,
      createdAt: entity.createdAt,
      updatedAt: entity.updatedAt,
    };
  },
};
