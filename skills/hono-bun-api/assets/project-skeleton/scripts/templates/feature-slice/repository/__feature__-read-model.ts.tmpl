import { and, asc, eq, gt } from 'drizzle-orm';
import type { Db } from '@shared/db/client';
import { __features__ } from '@shared/db/schema';
import type { __Feature__Dto, List__Features__Query, List__Features__Response } from '../__features__.schemas';

export class __Feature__ReadModel {
  constructor(private readonly db: Db) {}

  async getById(id: string): Promise<__Feature__Dto | null> {
    const rows = await this.db
      .select({
        id: __features__.id,
        name: __features__.name,
        status: __features__.status,
        createdAt: __features__.createdAt,
        updatedAt: __features__.updatedAt,
      })
      .from(__features__)
      .where(eq(__features__.id, id))
      .limit(1);

    return rows[0] ? this.toDto(rows[0]) : null;
  }

  async list(input: List__Features__Query): Promise<List__Features__Response> {
    const rows = await this.db
      .select({
        id: __features__.id,
        name: __features__.name,
        status: __features__.status,
        createdAt: __features__.createdAt,
        updatedAt: __features__.updatedAt,
      })
      .from(__features__)
      .where(
        and(
          input.status ? eq(__features__.status, input.status) : undefined,
          input.cursor ? gt(__features__.id, input.cursor) : undefined,
        ),
      )
      .orderBy(asc(__features__.id))
      .limit(input.limit + 1);

    const hasMore = rows.length > input.limit;
    const items = (hasMore ? rows.slice(0, input.limit) : rows).map((row) => this.toDto(row));

    return {
      items,
      nextCursor: hasMore ? items[items.length - 1]?.id ?? null : null,
    };
  }

  private toDto(row: {
    id: string;
    name: string;
    status: __Feature__Dto['status'];
    createdAt: Date;
    updatedAt: Date;
  }): __Feature__Dto {
    return {
      id: row.id,
      name: row.name,
      status: row.status,
      createdAt: row.createdAt.toISOString(),
      updatedAt: row.updatedAt.toISOString(),
    };
  }
}
