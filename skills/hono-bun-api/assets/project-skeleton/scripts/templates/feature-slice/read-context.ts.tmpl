import type { Context } from 'hono';
import type { AppEnv, ReadContext } from '@shared/hono/types';

/**
 * __Features__ReadContext — generalmente igual a ReadContext, pero acá podés agregar
 * deps específicas del feature (cache, search index, etc.).
 */
export type __Features__ReadContext = ReadContext;

export const build__Features__ReadContext = (c: Context<AppEnv>): __Features__ReadContext => ({
  db: c.get('db'),
  logger: c.get('logger'),
  auth: c.get('auth'),
});
