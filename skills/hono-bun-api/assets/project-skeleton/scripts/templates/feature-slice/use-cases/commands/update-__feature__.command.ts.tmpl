import { success, type Result } from '@shared/result';
import type { AppError } from '@shared/errors/app-error';
import type { EventBus } from '@shared/events/event-bus';
import type { TransactionManager } from '@shared/db/transaction';
import { eq } from 'drizzle-orm';
import { __features__ } from '@shared/db/schema';
import type { Clock } from '@/di-container';
import type { __Feature__Status, __Feature__Dto } from '../../__features__.schemas';
import { __feature__Updated } from '../../__features__.events';

export type Update__Feature__Command = { id: string; name?: string; status?: __Feature__Status; actorId: string | null };
export type Update__Feature__Deps = { tx: TransactionManager; eventBus: EventBus; clock: Clock };

export const update__Feature__Command = async (
  deps: Update__Feature__Deps,
  command: Update__Feature__Command,
): Promise<Result<__Feature__Dto, AppError>> => {
  const now = deps.clock.now();
  const [row] = await deps.tx.run((db) => db
    .update(__features__)
    .set({
      ...(command.name !== undefined && { name: command.name }),
      ...(command.status !== undefined && { status: command.status }),
      updatedAt: now,
    })
    .where(eq(__features__.id, command.id))
    .returning());

  if (!row) throw new Error('__Feature__ not found');
  const __feature__ = {
    id: row.id,
    name: row.name,
    status: row.status,
    createdAt: row.createdAt.toISOString(),
    updatedAt: row.updatedAt.toISOString(),
  };
  deps.eventBus.publish(__feature__Updated(__feature__.id, now));
  return success(__feature__);
};
