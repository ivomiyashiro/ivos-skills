import { failure, success, type Result } from '@shared/result';
import { notFound, type AppError } from '@shared/errors/app-error';
import type { Db } from '@shared/db/client';
import { eq } from 'drizzle-orm';
import { __features__ } from '@shared/db/schema';
import type { __Feature__Dto } from '../../__features__.schemas';

export type Get__Feature__ByIdQuery = { id: string; actorId: string | null };
export type Get__Feature__ByIdDeps = { db: Db };

export const get__Feature__ByIdQuery = async (
  deps: Get__Feature__ByIdDeps,
  query: Get__Feature__ByIdQuery,
): Promise<Result<__Feature__Dto, AppError>> => {
  const [row] = await deps.db.select().from(__features__).where(eq(__features__.id, query.id)).limit(1);
  if (!row) return failure(notFound('__Feature__', query.id));
  return success({
    id: row.id,
    name: row.name,
    status: row.status,
    createdAt: row.createdAt.toISOString(),
    updatedAt: row.updatedAt.toISOString(),
  });
};
