import { success, type Result } from '@shared/result';
import { type AppError } from '@shared/errors/app-error';
import type { Logger } from '@shared/observability/logger';
import type { EventBus, DomainEvent } from '@shared/events/event-bus';
import type { Clock } from '@/app';
import type { __Feature__Repo } from '../repository';
import type { Create__Feature__Input, __Feature__Dto } from '../schemas';
import type { __Feature__Created } from '../events';

export type Create__Feature__Deps = {
  repo: __Feature__Repo;
  eventBus: EventBus;
  logger: Logger;
  clock: Clock;
  userId: string | null;
};

/**
 * Handler del comando Create__Feature__.
 */
export const create__Feature__Handler = async (
  deps: Create__Feature__Deps,
  input: Create__Feature__Input,
): Promise<Result<__Feature__Dto, AppError>> => {
  const now = deps.clock.now();
  const id = crypto.randomUUID();

  await deps.repo.save({
    id,
    name: input.name,
    status: 'draft',
    createdAt: now,
    updatedAt: now,
  });

  const event: __Feature__Created = {
    type: '__Feature__Created',
    payload: { id, name: input.name },
    occurredAt: now,
  };
  deps.eventBus.publish(event satisfies DomainEvent);

  deps.logger.info({ id, name: input.name }, '__feature__ created');

  return success({
    id,
    name: input.name,
    status: 'draft',
    createdAt: now.toISOString(),
    updatedAt: now.toISOString(),
  });
};
