import { eq } from 'drizzle-orm';
import type { Db } from '@shared/db/client';
import { __modules__ } from '@shared/db/schema';
import type { __Module__Repository } from '../domain/__module__.repository';
import type { __Module__ } from '../domain/__module__.entity';
import { __Module__Mapper } from './__module__.mapper';

export class Drizzle__Module__Repository implements __Module__Repository {
  constructor(private readonly db: Db) {}

  async findById(id: string): Promise<__Module__ | null> {
    const rows = await this.db.select().from(__modules__).where(eq(__modules__.id, id)).limit(1);
    return rows[0] ? __Module__Mapper.toDomain(rows[0]) : null;
  }

  async save(entity: __Module__): Promise<void> {
    const row = __Module__Mapper.toPersistence(entity);

    await this.db
      .insert(__modules__)
      .values(row)
      .onConflictDoUpdate({
        target: __modules__.id,
        set: {
          name: row.name,
          status: row.status,
          updatedAt: row.updatedAt,
        },
      });
  }

  async delete(id: string): Promise<void> {
    await this.db.delete(__modules__).where(eq(__modules__.id, id));
  }
}
