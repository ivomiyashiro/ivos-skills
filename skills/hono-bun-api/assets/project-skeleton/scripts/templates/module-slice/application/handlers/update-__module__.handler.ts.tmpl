import { failure, success, type Result } from '@shared/result';
import { forbidden, notFound, type AppError } from '@shared/errors/app-error';
import type { Logger } from '@shared/observability/logger';
import type { EventBus } from '@shared/events/event-bus';
import type { Db } from '@shared/db/client';
import type { TransactionManager } from '@shared/db/transaction';
import type { Clock } from '@/container';
import type { __Module__Repository } from '../../domain/__module__.repository';
import { canUpdate__Module__ } from '../../domain/__module__.policies';
import type { __Module__Dto } from '../../__modules__.schemas';
import type { Update__Module__Command } from '../commands/update-__module__.command';

export type Update__Module__Deps = {
  createRepo: (db: Db) => __Module__Repository;
  tx: TransactionManager;
  eventBus: EventBus;
  logger: Logger;
  clock: Clock;
};

export const update__Module__Handler = async (
  deps: Update__Module__Deps,
  command: Update__Module__Command,
): Promise<Result<__Module__Dto, AppError>> => {
  const decision = canUpdate__Module__(command.actorId);
  if (!decision.allowed) return failure(forbidden(decision.reason));

  const updated = await deps.tx.run(async (db) => {
    const repo = deps.createRepo(db);
    const entity = await repo.findById(command.id);
    if (!entity) return null;

    entity.update({ name: command.name, status: command.status, now: deps.clock.now() });
    await repo.save(entity);
    return entity;
  });

  if (!updated) return failure(notFound('__Module__', command.id));

  deps.eventBus.publishMany(updated.pullEvents());
  deps.logger.info({ id: updated.id, actorId: command.actorId }, '__module__ updated');

  return success({
    id: updated.id,
    name: updated.name,
    status: updated.status,
    createdAt: updated.createdAt.toISOString(),
    updatedAt: updated.updatedAt.toISOString(),
  });
};
