import { success, type Result } from '@shared/result';
import type { AppError } from '@shared/errors/app-error';
import type { Logger } from '@shared/observability/logger';
import type { EventBus } from '@shared/events/event-bus';
import type { Db } from '@shared/db/client';
import type { TransactionManager } from '@shared/db/transaction';
import type { Clock } from '@/container';
import type { __Module__Repository } from '../../domain/__module__.repository';
import { __Module__ } from '../../domain/__module__.entity';
import type { __Module__Dto } from '../../__modules__.schemas';
import type { Create__Module__Command } from '../commands/create-__module__.command';

export type Create__Module__Deps = {
  createRepo: (db: Db) => __Module__Repository;
  tx: TransactionManager;
  eventBus: EventBus;
  logger: Logger;
  clock: Clock;
};

export const create__Module__Handler = async (
  deps: Create__Module__Deps,
  command: Create__Module__Command,
): Promise<Result<__Module__Dto, AppError>> => {
  const entity = __Module__.create({ name: command.name, now: deps.clock.now() });

  await deps.tx.run(async (db) => {
    await deps.createRepo(db).save(entity);
  });

  deps.eventBus.publishMany(entity.pullEvents());
  deps.logger.info({ id: entity.id, actorId: command.actorId }, '__module__ created');

  return success({
    id: entity.id,
    name: entity.name,
    status: entity.status,
    createdAt: entity.createdAt.toISOString(),
    updatedAt: entity.updatedAt.toISOString(),
  });
};
