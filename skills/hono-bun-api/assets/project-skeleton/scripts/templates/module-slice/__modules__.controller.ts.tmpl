import type { Context } from 'hono';
import type { AppEnv } from '@shared/hono/types';
import { toHttpResponse } from '@shared/errors/to-http';
import type { AppContainer } from '@/container';
import { create__Module__Handler } from './application/handlers/create-__module__.handler';
import { update__Module__Handler } from './application/handlers/update-__module__.handler';
import { get__Module__ByIdHandler } from './application/handlers/get-__module__-by-id.handler';
import { list__Modules__Handler } from './application/handlers/list-__modules__.handler';
import type { Create__Module__Input, List__Modules__Query, Update__Module__Input } from './__modules__.schemas';

type ControllerContext = Context<AppEnv, string, any>;
type IdParam = { id: string };

export const create__Module__Controller =
  (container: AppContainer) =>
  async (c: ControllerContext) => {
    const body = c.req.valid('json') as Create__Module__Input;
    const result = await create__Module__Handler(
      {
        createRepo: container.create__Module__Repository,
        tx: container.tx,
        eventBus: container.eventBus,
        logger: c.get('logger'),
        clock: container.clock,
      },
      { ...body, actorId: c.get('auth')?.userId ?? null },
    );

    return toHttpResponse(c, result, 201);
  };

export const update__Module__Controller =
  (container: AppContainer) =>
  async (c: ControllerContext) => {
    const { id } = c.req.valid('param') as IdParam;
    const body = c.req.valid('json') as Update__Module__Input;
    const result = await update__Module__Handler(
      {
        createRepo: container.create__Module__Repository,
        tx: container.tx,
        eventBus: container.eventBus,
        logger: c.get('logger'),
        clock: container.clock,
      },
      { id, ...body, actorId: c.get('auth')?.userId ?? null },
    );

    return toHttpResponse(c, result, 200);
  };

export const get__Module__Controller =
  (container: AppContainer) =>
  async (c: ControllerContext) => {
    const { id } = c.req.valid('param') as IdParam;
    const result = await get__Module__ByIdHandler(
      { readModel: container.__moduleCamel__ReadModel },
      { id, actorId: c.get('auth')?.userId ?? null },
    );

    return toHttpResponse(c, result, 200);
  };

export const list__Modules__Controller =
  (container: AppContainer) =>
  async (c: ControllerContext) => {
    const query = c.req.valid('query') as List__Modules__Query;
    const result = await list__Modules__Handler(
      { readModel: container.__moduleCamel__ReadModel },
      { ...query, actorId: c.get('auth')?.userId ?? null },
    );

    return toHttpResponse(c, result, 200);
  };
