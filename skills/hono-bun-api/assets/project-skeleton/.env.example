NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_GRACE_MS=2000

# --- Supabase Auth ---
# Project Settings → API en Supabase Dashboard.
# Dejar vacíos en local si todavía no conectaste Supabase: el authMiddleware
# correrá con un verify que devuelve null (todas las requests = anónimas).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Preferir JWKS rotables. SUPABASE_JWT_SECRET es fallback para proyectos HS256.
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
