import type { DomainEvent } from '@shared/events/event-bus';

/**
 * Domain events del feature __Feature__.
 */

export type __Feature__Created = DomainEvent<
  '__Feature__Created',
  { id: string; name: string }
>;

export type __Feature__Updated = DomainEvent<
  '__Feature__Updated',
  { id: string; changes: Record<string, unknown> }
>;

export type __Feature__Event = __Feature__Created | __Feature__Updated;
